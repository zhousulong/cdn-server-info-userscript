{
    "name": "cdn-server-info-userscript",
    "version": "7.62.0",
    "description": "A userscript to display CDN and server information",
    "main": "cdn-server-info.user.js",
    "scripts": {
        "test": "npm run test:cname && npm run test:detection",
        "test:cname": "node tools/test_cname_matching.mjs",
        "test:detection": "node tools/test_parse_info.mjs",
        "release:check": "node tools/check-version.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "version:patch": "node .agent/workflows/scripts/update-version.js patch",
        "version:minor": "node .agent/workflows/scripts/update-version.js minor",
        "version:major": "node .agent/workflows/scripts/update-version.js major"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhousulong/cdn-server-info-userscript.git"
    },
    "keywords": [
        "userscript",
        "cdn",
        "server",
        "tampermonkey",
        "information"
    ],
    "author": "Gemini (AI Designer & Coder)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/zhousulong/cdn-server-info-userscript/issues"
    },
    "homepage": "https://github.com/zhousulong/cdn-server-info-userscript#readme",
    "devDependencies": {
        "eslint": "^9.32.0",
        "prettier": "^3.6.2"
    }
}
